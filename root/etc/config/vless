config vless 'main'
	option scope 'all'
	option mode 'all'
	option dns_mode 'vpn'
	option remote_dns '1.1.1.1'
	option direct_dns 'tls://77.88.8.8'
	option bootstrap_dns '77.88.8.8'
	option kill_switch '0'
	option block_quic '1'
	option block_ipv6 '1'
	option bypass_vpn '1'
	option bypass_ru '1'
	option tun_stack 'system'
	option mtu '1400'
	option log_level 'warn'
	option user_agent 'Happ/3.13.0'
	option update_interval '24'
	option selected 'auto'
	list ifaces 'lan'
