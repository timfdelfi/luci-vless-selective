#!/bin/sh /etc/rc.common
# VPN (luci-vless-selective): запуск sing-box под управлением procd

START=99
STOP=10
USE_PROCD=1

PIDFILE=/var/run/vless.pid

start_service() {
	# Очистка остатков после некорректного завершения или сбоя. Делаем до всех проверок:
	# иначе при пустом списке серверов dnsmasq так и остался бы с адресом мёртвого DNS.
	# Одного удаления файла мало: dnsmasq держит прочитанную настройку в памяти.
	# Если sing-box уже работает (повторный start), чужими остатками это не считается.
	local d stale=0
	if ! { [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; }; then
		for d in /tmp/dnsmasq*.d; do
			[ -f "$d/vless.conf" ] && { rm -f "$d/vless.conf"; stale=1; }
		done
		[ "$stale" = 1 ] && /etc/init.d/dnsmasq restart >/dev/null 2>&1
	fi

	# stderr от jq глушим сами: перенаправление на [ ниже его не покрывает
	[ -s /etc/vless/servers.json ] && [ "$(jq 'length' /etc/vless/servers.json 2>/dev/null || echo 0)" -gt 0 ] 2>/dev/null || {
		mkdir -p /var/run/vless
		echo "Нет серверов — добавьте ссылку в разделе Службы → VPN" > /var/run/vless/last_error 2>/dev/null
		return 0
	}
	/usr/bin/vless prepare || return 0

	procd_open_instance vless
	procd_set_param command /usr/bin/vless run
	procd_set_param pidfile "$PIDFILE"
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	/usr/bin/vless net-down
}

service_stopped() {
	/usr/bin/vless net-down
}

reload_service() {
	restart
}

service_triggers() {
	procd_add_reload_trigger vless
}
