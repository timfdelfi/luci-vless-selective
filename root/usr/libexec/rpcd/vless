#!/bin/sh
# rpcd-плагин: мост между веб-интерфейсом LuCI и /usr/bin/vless

VLESS="${VLESS_BIN:-/usr/bin/vless}"
RUN="${VLESS_RUN:-/var/run/vless}"

log_err() {
	[ -s "$RUN/rpcd.err" ] || return 0
	local msg
	msg="$(tr '\n' ' ' < "$RUN/rpcd.err" 2>/dev/null | cut -c 1-200 2>/dev/null)"
	[ -n "$msg" ] && logger -t vless "rpcd $1: $msg" 2>/dev/null
}

# run КОМАНДА [АРГУМЕНТЫ…] — вызвать бэкенд; stderr логируется в $RUN/rpcd.err
run() {
	local out
	out="$("$VLESS" "$@" 2>"$RUN/rpcd.err")"
	if [ -n "$out" ] && printf '%s' "$out" | jq -e . >/dev/null 2>&1; then
		printf '%s\n' "$out"
	else
		# Логируем stderr бэкенда для диагностики
		log_err "$1"
		printf '{"ok":false,"error":"Бэкенд не ответил (команда %s). Выполните на роутере: vless selftest"}\n' "$1"
	fi
}

# run_discord КОМАНДА [АРГУМЕНТЫ…] — то же для vless-discord
run_discord() {
	local out
	out="$("${VLESS_DISCORD_BIN:-/usr/bin/vless-discord}" "$@" 2>"$RUN/rpcd.err")"
	if [ -n "$out" ] && printf '%s' "$out" | jq -e . >/dev/null 2>&1; then
		printf '%s\n' "$out"
	else
		printf '{"ok":false,"error":"Модуль Discord не ответил. Выполните на роутере: vless-discord selftest"}\n'
	fi
}

case "$1" in
	list)
		cat <<'JSON'
{
	"state":      {},
	"status":     {},
	"devices":    {},
	"logs":       {},
	"connect":    {},
	"disconnect": {},
	"check":      {},
	"ping":       { "id": "string" },
	"ping-direct": { "id": "string" },
	"clear":      {},
	"clearlog":   {},
	"add":        { "text": "string" },
	"remove":     { "id": "string" },
	"refresh":    { "id": "string" },
	"select":     { "id": "string" },
	"set":        { "settings": "object" },
	"discord-status": {},
	"discord-run":    { "action": "string" }
}
JSON
		;;
	call)
		IN="$(cat)"
		arg() { printf '%s' "$IN" | jq -r --arg k "$1" '.[$k] // empty' 2>/dev/null; }
		case "$2" in
			state|status|devices|logs|check|clear|clearlog|connect|disconnect)
				run "$2" ;;
			ping|remove|refresh|select)
				run "$2" "$(arg id)" ;;
			ping-direct)
				run ping-direct "$(arg id)" ;;
			add)
				# Текст со ссылками идёт через stdin, а не через аргумент командной строки:
				# argv виден всем локальным пользователям в /proc/*/cmdline, а там —
				# полные ключи vless и токены подписок.
				out="$(printf '%s' "$IN" | jq -j '.text // empty' 2>/dev/null | "$VLESS" add 2>"$RUN/rpcd.err")"
				if [ -n "$out" ] && printf '%s' "$out" | jq -e . >/dev/null 2>&1; then
					printf '%s\n' "$out"
				else
					log_err add
					printf '{"ok":false,"error":"Не удалось добавить серверы"}\n'
				fi ;;
			discord-status)
				run_discord status ;;
			discord-run)
				# только фоновый запуск: установка и перебор стратегий идут минуты, rpcd столько не ждёт
				case "$(arg action)" in
					install|update|auto|apply) run_discord bg "$(arg action)" ;;
					*) echo '{"ok":false,"error":"unknown action"}' ;;
				esac ;;
			set)
				out="$(printf '%s' "$IN" | jq -c '.settings // {}' | "$VLESS" set 2>"$RUN/rpcd.err")"
				if [ -n "$out" ]; then printf '%s\n' "$out"; else echo '{"ok":false,"error":"Не удалось сохранить настройки"}'; fi ;;
			*)
				echo '{"ok":false,"error":"unknown method"}' ;;
		esac
		;;
esac