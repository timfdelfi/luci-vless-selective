#!/bin/sh
# vless — бэкенд приложения «VPN» (luci-vless-selective)
# Управляет подписками, собирает конфиг sing-box, поднимает маршрутизацию и DNS.
# Все команды печатают JSON, чтобы их мог вызывать веб-интерфейс.

DIR="${VLESS_DIR:-/etc/vless}"
RUN="${VLESS_RUN:-/var/run/vless}"
LIB="${VLESS_LIB:-/usr/share/vless}"
SERVERS="$DIR/servers.json"
SOURCES="$DIR/sources.json"
HIDDEN="$DIR/hidden.json"   # серверы подписок, удалённые пользователем: [{id,source}]
CONFIG="$RUN/config.json"
PIDFILE="${VLESS_PID:-/var/run/vless.pid}"

TUN="vless0"
TABLE=100
API_PORT=9099
MIXED_PORT=2080
DNS_LISTEN="127.0.0.77"
TAB="$(printf '\t')"

mkdir -p "$DIR" "$RUN"
chmod 700 "$DIR" "$RUN" 2>/dev/null   # здесь ключи и токены подписок — только root
[ -s "$SERVERS" ] || echo '[]' > "$SERVERS"
[ -s "$SOURCES" ] || echo '[]' > "$SOURCES"
[ -s "$HIDDEN" ] || echo '[]' > "$HIDDEN"
chmod 600 "$SERVERS" "$SOURCES" "$HIDDEN" 2>/dev/null

PRESET_KEYS="telegram youtube discord meta x ai adult"

# Подписки скачиваются «как Happ на Android»: панели (Remnawave, Marzban и др.) по этим
# заголовкам решают, какой формат отдать, и не подсовывают заглушку «клиент не поддерживается».
VLESS_UA_DEFAULT="Happ/3.13.0"
VLESS_ANDROID_VER="15"
VLESS_DEVICE_MODEL="Pixel 8"

# ---------------------------------------------------------------- модули
# Код разнесён по /usr/share/vless/lib/*.sh (по одной зоне ответственности на файл).
# Порядок подключения не важен: модули только объявляют функции и переменные.
VLESS_MODULES="util validate settings discord cron subscriptions lifecycle net selective probe status"
for _m in $VLESS_MODULES; do
	if [ ! -r "$LIB/lib/$_m.sh" ]; then
		echo "vless: нет модуля $LIB/lib/$_m.sh — переустановите приложение" >&2
		exit 1
	fi
	# shellcheck source=/dev/null
	. "$LIB/lib/$_m.sh"
done

# ---------------------------------------------------------------- точка входа

case "$1" in
	state)      cmd_state ;;
	status)     cmd_status ;;
	add)        shift; locked cmd_add "$@" ;;
	remove)     locked cmd_remove "$2" ;;
	refresh)    locked cmd_refresh "$2" ;;
	# Результат не показывается (команда вызывается из cron), но о неудаче
	# обязан остаться след: иначе битая подписка годами выглядит как «просто не обновилось».
	update-all) locked cmd_update_all ;;
	select)     locked cmd_select "$2" ;;
	set)        locked cmd_set ;;
	clear)      locked cmd_clear ;;
	clearlog)   cmd_clearlog ;;
	check)      cmd_check ;;
	ping)       cmd_ping "$2" ;;
	ping-direct) cmd_ping_direct "$2" ;;
	devices)    cmd_devices ;;
	logs)       cmd_logs ;;
	# connect/disconnect тоже сериализуем: без этого автообновление по cron
	# могло перезапустить службу поверх ручного подключения (и наоборот).
	# prepare блокировку не берёт, поэтому рекурсии и дедлока нет.
	connect)    locked cmd_connect ;;
	disconnect) locked cmd_disconnect ;;
	prepare)    cmd_prepare ;;
	run)        cmd_run ;;
	net-up)     net_up ;;
	net-down)   net_down ;;
	selective-lists) selective_lists ;;
	selective-nft)   selective_nft_conf ;;
	sync-cron)  sync_cron ;;
	discord-sync) locked cmd_discord_sync ;;
	effective)  effective_settings ;;
	settings)   settings_json ;;
	fetch-core) cmd_fetch_core "$2" ;;
	export)     cmd_export ;;
	import)     locked cmd_import ;;
	selftest)   cmd_selftest ;;
	*)
		echo "Использование: vless {state|status|connect|disconnect|add <текст>|remove <id>|refresh [id]|select <id|auto>|set|check|ping|logs|clearlog|clear|export|import|fetch-core|selftest}" >&2
		exit 1 ;;
esac
