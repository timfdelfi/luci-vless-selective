#!/bin/sh /etc/rc.common
# Обход Discord через zapret (luci-vless-selective): запуск nfqws под управлением procd

START=98
STOP=11
USE_PROCD=1

D=/usr/bin/vless-discord

start_service() {
	# prestart сам решает, нужен ли запуск: режим, установлен ли nfqws, нет ли чужого zapret
	"$D" prestart || return 0
	local cmdline
	cmdline="$("$D" cmdline)" || return 0

	procd_open_instance nfqws
	# shellcheck disable=SC2086
	procd_set_param command $cmdline
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance

	# После загрузки сеть поднимается не сразу: проверяем Discord и при необходимости
	# подбираем стратегию или переключаемся на VPN уже в фоне.
	# Если сейчас идёт перебор стратегий (он перезапускает службу сам), второй проверки не нужно.
	[ -d /var/run/vless/discord.lock ] || ( sleep 25; "$D" auto >/dev/null 2>&1 ) >/dev/null 2>&1 &
}

stop_service() {
	"$D" nft-down
}

service_stopped() {
	"$D" nft-down
}
