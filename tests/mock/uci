#!/bin/sh
# Минимальная заглушка uci для тестов: хранит ключи в файле $UCI_DB (строки «ключ<TAB>значение»)
DB="${UCI_DB:?}"; touch "$DB"; T="$(printf '\t')"
q=0; [ "$1" = "-q" ] && { q=1; shift; }
cmd="$1"; shift
case "$cmd" in
	get)
		v="$(awk -F"$T" -v k="$1" '$1==k{printf "%s%s", (n++?" ":""), $2}' "$DB")"
		[ -n "$v" ] && { printf '%s\n' "$v"; exit 0; }
		[ "$1" = "vless.main" ] && grep -q "^vless.main$T" "$DB" && { echo vless; exit 0; }
		exit 1 ;;
	set)  k="${1%%=*}"; v="${1#*=}"; grep -v "^$k$T" "$DB" > "$DB.n"; printf '%s\t%s\n' "$k" "$v" >> "$DB.n"; mv "$DB.n" "$DB" ;;
	add_list) k="${1%%=*}"; v="${1#*=}"; printf '%s\t%s\n' "$k" "$v" >> "$DB" ;;
	delete) grep -v "^$1$T" "$DB" > "$DB.n"; mv "$DB.n" "$DB" ;;
	show) exit 0 ;;
	commit) exit 0 ;;
	*) exit 0 ;;
esac
