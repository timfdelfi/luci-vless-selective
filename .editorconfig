root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{sh,jq}]
indent_style = tab

[{root/usr/bin/*,root/etc/init.d/*,root/usr/libexec/rpcd/*}]
indent_style = tab

[*.js]
indent_style = tab

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.bat]
end_of_line = crlf
